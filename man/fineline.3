.TH fineline 3
.SH NAME
fineline(), fineline_alloc(), fineline_free(), fineline_tty(), fineline_tty_alloc(), fineline_curses(), fineline_curses_alloc() \- Line Input Library

.SH SYNOPSIS

.B char
.RB *fineline "(const char"
.IB prompt );
.br
.B fineline
.RB *fineline_tty_alloc (void);
.br
.B char
.RB *fineline_tty "(fineline_t"
.IB *fine ", const char" *prompt );
.br
.B fineline_t
.RB *fineline_alloc (void);
.br
.B void
.RB fineline_free (fineline_t
.IB fine );
.br
